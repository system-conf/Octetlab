// Octetlab MCP server (docs/MCP_SERVER.md): a separate Worker next to the web app's static assets.
// Name must be lowercase: Cloudflare requirement. Paths are relative to this file.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "octetlabmcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // agents/mcp/server uses AsyncLocalStorage (node:async_hooks).
  "compatibility_flags": ["nodejs_compat"],
  // Served at octetlabmcp.<subdomain>.workers.dev; per-version preview URLs are not used.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Page of the web app that opens share links (`<APP_LAB_URL>#lab=…`).
    "APP_LAB_URL": "https://octetlab.slovveis.workers.dev/lab",
    // Web app origin of live links (`<APP_ORIGIN>/live/<labId>`, docs/LIVE_LABS.md).
    "APP_ORIGIN": "https://octetlab.slovveis.workers.dev",
    // Origins allowed to read /live/* and open its WebSocket (comma separated).
    "APP_ORIGINS": "https://octetlab.slovveis.workers.dev,http://localhost:5300,http://localhost:4173"
  },
  // One LabRoom per lab (docs/LIVE_LABS.md §3): SQLite-backed Durable Object, Free plan compatible.
  "durable_objects": {
    "bindings": [{ "name": "LAB_ROOMS", "class_name": "LabRoom" }]
  },
  // v2: ShareStore (docs/SHARE_PAGES.md §3), one SQLite-backed object holding every share page. The app
  // Worker (root wrangler.jsonc) binds to it with script_name "octetlabmcp"; this Worker needs no binding.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LabRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ShareStore"] }
  ],
  "kv_namespaces": [
    {
      // Labs saved before live labs: read-only fallback, removed in the contract step (≥ 2026-11-20).
      "binding": "LABS",
      // Namespace "octetlabmcp_labs" (an identifier, not a secret). `wrangler dev` uses a local
      // simulated namespace instead.
      "id": "c61b693ecc5146a8b87a2b3388435640"
    }
  ],
  "ratelimits": [
    {
      // Requests to /mcp per client IP. namespace_id: any positive integer unique in the account.
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "4501",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
